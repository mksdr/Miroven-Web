---
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import { publishedPosts } from '../../../lib/blog';
const posts = await publishedPosts();
---
<Base title="블로그"><section class="section wrap"><div class="section-heading"><p class="eyebrow">아카이브</p><h1>기록 곁의 이야기</h1><p>Miroven이 지향하는 기록 방식과 사용 안내를 전합니다.</p></div><div class="post-grid">{posts.map(post => <PostCard post={post} heading="h2" />)}</div></section></Base>
