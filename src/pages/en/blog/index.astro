---
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import { publishedPosts } from '../../../lib/blog';
const posts = await publishedPosts('en');
---
<Base title="Blog"><section class="section wrap"><div class="section-heading"><p class="eyebrow">Archive</p><h1>Stories alongside your journal</h1><p>Guides and stories about journaling with Miroven.</p></div><div class="post-grid">{posts.map(post => <PostCard post={post} heading="h2" />)}</div></section></Base>
